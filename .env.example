# API — Backend Environment Variables
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meditrack_ug
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-a-secure-random-string-32chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=sandbox
AT_SHORTCODE=MEDTRACK
# Production on Render free tier: use Resend (HTTPS) — SMTP ports 587/465 are blocked
# Set these in your Render service environment variables as well:
RESEND_API_KEY=
RESEND_FROM=MediTrack Alerts <onboarding@resend.dev>
# Local dev fallback — Gmail SMTP works on localhost
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# For Render, set this to your deployed frontend URL (for example, https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Frontend — required for Vercel / local web app (Supabase-only, no Express needed)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — only if running the legacy Express API locally
# VITE_API_URL=http://localhost:3001/api/v1
